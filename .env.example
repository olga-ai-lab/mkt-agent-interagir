# --- Supabase (projeto compartilhado: vywalfkdlbmuoyxfgjhc) ---
SUPABASE_URL=https://vywalfkdlbmuoyxfgjhc.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Schema deste módulo — nunca "public" (dados de produção do Livonius).
SUPABASE_SCHEMA=interagir

# --- OpenAI (Curador / Redator / Revisor / Ranker + extração + gpt-image-1) ---
OPENAI_API_KEY=
OPENAI_CURADOR_MODEL=gpt-4o
OPENAI_CURADOR_PERMISSIVE_MODEL=gpt-5
OPENAI_REDATOR_MODEL=gpt-5
OPENAI_REVISOR_MODEL=gpt-4o
OPENAI_RANKER_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Anthropic (Designer — prompt visual) ---
ANTHROPIC_API_KEY=
ANTHROPIC_DESIGNER_MODEL=claude-sonnet-4-5

# --- Storage / Edge Functions (mantidas no Supabase) ---
MKT_IMAGE_BUCKET=interagir-article-images
# COMPOSITE_LOGO_EF e RECEIVE_UPLOAD_EF assumem interagir-composite-logo e
# interagir-receive-n8n-upload sob o SUPABASE_URL; sobrescreva se necessário.

# --- RSS feeds ---
RSS_FEED_LIVO=https://rss.app/feeds/_KEXK5NbJ9zcBgT8r.xml
